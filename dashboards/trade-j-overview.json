      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "histogram_quantile(0.5, sum by (le) (rate(${broker}_order_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
