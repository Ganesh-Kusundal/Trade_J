            { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "none",
          "description": "${broker}_websocket_connected — 1 = connected, 0 = disconnected. ObservabilityConfiguration.java:170"
        }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "${broker}_websocket_connected", "legendFormat": "{{__name__}}" }
