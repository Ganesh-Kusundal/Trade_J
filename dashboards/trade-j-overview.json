  "description": "Trade-J runtime overview. Wires the 30+ Micrometer gauges emitted by ObservabilityConfiguration (and the supporting config in PrometheusConfiguration, VirtualThreadConfiguration, StrategyMetricsConfiguration, BrokerResilienceMetricsConfiguration) to a single Grafana dashboard. Datasource: Prometheus at /actuator/prometheus. Source repo: trade-j app/ module, ObservabilityConfiguration.java:154-301.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Gateway Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "id": 100,
      "panels": []
